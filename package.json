{
  "name": "sync-setup",
  "version": "0.1.2",
  "description": "Sync an Obsidian community plugin setup through a vault profile.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2018 --outfile=main.js --watch",
    "build": "npm run typecheck && esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2018 --outfile=main.js",
    "package": "npm run build && node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "release:verify": "npm test && npm run lint && npm run package",
    "version": "node scripts/sync-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "obsidian": "^1.13.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
